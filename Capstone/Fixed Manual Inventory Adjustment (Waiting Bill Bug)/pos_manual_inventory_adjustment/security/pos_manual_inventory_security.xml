<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Manual Inventory Categories -->
        <record id="module_category_manual_inventory" model="ir.module.category">
            <field name="name">Manual Inventory</field>
            <field name="description">Access rights for manual inventory operations</field>
            <field name="sequence">25</field>
        </record>

        <!-- Manual Inventory User Group -->
        <record id="group_manual_inventory_user" model="res.groups">
            <field name="name">Manual Inventory User</field>
            <field name="comment">User can create and manage manual inventory adjustments for assigned locations only
            </field>
            <field name="category_id" ref="module_category_manual_inventory"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_manual_on_hand" model="res.groups">
            <field name="name">Can See On Hand</field>
        </record>

        <!-- Manual Inventory Admin Group -->
        <record id="group_manual_inventory_admin" model="res.groups">
            <field name="name">Manual Inventory Admin</field>
            <field name="comment">Admin can create and manage manual inventory adjustments for all locations</field>
            <field name="category_id" ref="module_category_manual_inventory"/>
            <field name="implied_ids" eval="[(4, ref('group_manual_inventory_user'))]"/>
        </record>

        <!-- Record Rules for location-based access -->
        <record id="pos_manual_inventory_user_rule" model="ir.rule">
            <field name="name">Manual Inventory: User can see own records</field>
            <field name="model_id" ref="model_pos_manual_inventory"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_manual_inventory_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Admin can see all records -->
        <record id="pos_manual_inventory_admin_rule" model="ir.rule">
            <field name="name">Manual Inventory: Admin can see all records</field>
            <field name="model_id" ref="model_pos_manual_inventory"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_manual_inventory_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>