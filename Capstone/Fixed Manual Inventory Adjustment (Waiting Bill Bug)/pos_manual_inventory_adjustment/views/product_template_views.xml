<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_product_form_view_inventory_button_access" model="ir.ui.view">
        <field name="name">product.product.form.inventory.button.access</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form[1]/sheet[@name='product_form']/div[@name='button_box']/t[1]/button[@name='action_update_quantity_on_hand']"
                   position="attributes">
                <attribute name="groups">pos_manual_inventory_adjustment.group_manual_on_hand</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_inventory_button_access" model="ir.ui.view">
        <field name="name">product.template.form.inventory.button.access</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form[1]/sheet[@name='product_form']/div[@name='button_box']/t[1]/button[@name='action_update_quantity_on_hand']"
                   position="attributes">
                <attribute name="groups">pos_manual_inventory_adjustment.group_manual_on_hand</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_inventory_button_kanban" model="ir.ui.view">
        <field name="name">product.template.kanban.inventory.button.access</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban[1]/templates[1]/t[@t-name='card']/main[1]/div[2]"
                   position="attributes">
                <attribute name="groups">pos_manual_inventory_adjustment.group_manual_on_hand</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_product_tree_view_inventory_button_access" model="ir.ui.view">
        <field name="name">product.product.tree.inventory.button.access</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_available']"
                   position="attributes">
                <attribute name="groups">pos_manual_inventory_adjustment.group_manual_on_hand</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_view_inventory_button_access" model="ir.ui.view">
        <field name="name">product.template.tree.inventory.button.access</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_available']"
                   position="attributes">
                <attribute name="groups">pos_manual_inventory_adjustment.group_manual_on_hand</attribute>
            </xpath>
        </field>
    </record>
</odoo>
