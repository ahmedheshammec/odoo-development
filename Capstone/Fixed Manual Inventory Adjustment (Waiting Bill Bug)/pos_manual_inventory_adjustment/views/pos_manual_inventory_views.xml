<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for inventory adjustment -->
    <data noupdate="1">
        <record id="seq_pos_manual_inventory" model="ir.sequence">
            <field name="name">POS Manual Inventory</field>
            <field name="code">pos.manual.inventory</field>
            <field name="prefix">PMI</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <!-- Tree view for inventory adjustments -->
    <record id="view_pos_manual_inventory_tree" model="ir.ui.view">
        <field name="name">pos.manual.inventory.tree</field>
        <field name="model">pos.manual.inventory</field>
        <field name="arch" type="xml">
            <list string="Manual Inventory Adjustments" decoration-info="state=='draft'" decoration-primary="state=='count_requested'" decoration-success="state=='submitted'" decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="location_id"/>
                <field name="state" widget="badge" decoration-info="state=='draft'" decoration-primary="state=='count_requested'" decoration-warning="state=='counted'" decoration-success="state=='submitted'" decoration-danger="state=='cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Form view for inventory adjustments -->
    <record id="view_pos_manual_inventory_form" model="ir.ui.view">
        <field name="name">pos.manual.inventory.form</field>
        <field name="model">pos.manual.inventory</field>
        <field name="arch" type="xml">
            <form string="Manual Inventory Adjustment">
                <header>
                    <button name="action_request_count" string="Request Count" type="object" 
                            invisible="state != 'draft' or not location_id"/>
                    <button name="action_count" string="Mark as Counted" type="object" class="oe_highlight" 
                            invisible="state not in ['draft', 'count_requested']"/>
                    <button name="action_print_sheet" string="Print Count Sheet" type="object" 
                            invisible="state not in ['draft', 'count_requested', 'counted']"/>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" 
                            invisible="not (state == 'counted' and verified_sheet)"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            invisible="state in ['submitted', 'cancelled']"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" 
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,count_requested,counted,submitted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="location_id" readonly="0"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="verified_sheet" invisible="state in ['draft', 'count_requested']"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="products_in_location_ids" invisible="1"/>
                            <field name="line_ids" context="{'default_location_id': location_id}" readonly="state not in ['draft', 'count_requested']">
                                <list string="Inventory Lines" editable="bottom">
                                    <field name="location_id" column_invisible="1"/>
                                    <field name="state" column_invisible="1"/>
                                    <field name="product_id" domain="[('id', 'in', parent.products_in_location_ids)]" readonly="parent.state not in ['draft', 'count_requested']" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="product_barcode" optional="show" readonly="1"/>
                                    <field name="product_uom_id" readonly="1"/>
                                    <field name="theoretical_qty" column_invisible="1" readonly="1"/>
                                    <field name="counted_qty" readonly="parent.state not in ['draft', 'count_requested']"/>
                                    <field name="difference" column_invisible="1" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1" placeholder="Add any additional notes about this inventory count..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_pos_manual_inventory_search" model="ir.ui.view">
        <field name="name">pos.manual.inventory.search</field>
        <field name="model">pos.manual.inventory</field>
        <field name="arch" type="xml">
            <search string="Manual Inventory Adjustments">
                <field name="name"/>
                <field name="user_id"/>
                <field name="location_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Count Requested" name="count_requested" domain="[('state', '=', 'count_requested')]"/>
                <filter string="Counted" name="counted" domain="[('state', '=', 'counted')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <separator/>
                <filter string="My Inventories" name="my_inventories" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Location" name="group_location" domain="[]" context="{'group_by': 'location_id'}"/>
                    <filter string="Created By" name="group_user" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter string="Date" name="group_date" domain="[]" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for inventory adjustments -->
    <record id="action_pos_manual_inventory" model="ir.actions.act_window">
        <field name="name">Manual Inventory Adjustments</field>
        <field name="res_model">pos.manual.inventory</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pos_manual_inventory_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new manual inventory adjustment
            </p>
            <p>
                Use this feature to manually count inventory and create adjustments from the POS interface.
                You can add products, enter counted quantities, print count sheets for signature, 
                and submit the adjustments to update your inventory.
            </p>
        </field>
    </record>

    <!-- Menu item under POS Orders -->
    <menuitem id="menu_pos_manual_inventory"
        name="Manual Inventory"
        parent="point_of_sale.menu_point_of_sale"
        action="action_pos_manual_inventory"
        sequence="15"
        groups="pos_manual_inventory_adjustment.group_manual_inventory_user"/>

</odoo>